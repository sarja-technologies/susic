{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Susic",
  "version": "0.3.0",
  "identifier": "app.susic.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Susic", "width": 1200, "height": 780, "minWidth": 760, "minHeight": 560, "center": true, "dragDropEnabled": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://i.ytimg.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Music",
    "shortDescription": "Offline-first music library and player",
    "longDescription": "Susic is a beautiful, offline-first, cross-platform music library and player.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": { "deb": { "depends": ["libasound2t64 | libasound2"] } }
  }
}
